# ── Required ──────────────────────────────────────────────────────────

# Beds24 READ token — generated in the Beds24 dashboard under
# Settings → Apps → API v2 → Generate token. Choose READ scope.
BEDS24_READ_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────

# Beds24 WRITE refresh token. When present, write tools are registered.
# Generate in the same dashboard with WRITE scope.
# Leave blank to run in read-only mode.
BEDS24_WRITE_REFRESH_TOKEN=

# Beds24 API base URL. Override only for testing or self-hosted proxies.
BEDS24_API_URL=https://api.beds24.com/v2

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Max concurrent Beds24 requests (default 4 — keep low to respect rate limits)
BEDS24_MAX_CONCURRENCY=4

# HTTP transport (used only when --http is passed on the CLI)
HTTP_PORT=3000
